## assert-last-key-contains Service ExecStartPre " --opt o=uid=0,gid=11,rw,compress=zstd "
## assert-last-key-contains Service ExecStartPre " --opt type=btrfs "
## assert-last-key-contains Service ExecStartPre " --opt device=/dev/vda1 "
## assert-last-key-contains Service ExecStartPre " --opt copy "

[Volume]
# Test usernames too
User=root
Group=11
Device=/dev/vda1
Type=btrfs
Options=rw,compress=zstd
Copy=yes
